# Database and Services
DATABASE_URL=postgres://perp:password@localhost:5432/perp_db

# Ports
API_GATEWAY_PORT=8080
PORT=6000
WS_PORT=7070

# Service URLs for Gateway Routing
AUTH_SERVICE_URL=http://localhost:6000
ORDER_SERVICE_URL=http://localhost:6000
MARKET_SERVICE_URL=http://localhost:6000
WALLET_SERVICE_URL=http://localhost:6000
WS_SERVICE_URL=ws://localhost:7070

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,https://fishstudio.in,https://admin.fishstudio.in,https://seller.fishstudio.in,https://fish-studio-user-ui.vercel.app,https://fish-studio-admin-ui.vercel.app,https://fish-studio-seller-ui.vercel.app

# JWT Secrets
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
ACCESS_TOKEN_JWT_SECRET_KEY=ilovekiyara
REFRESH_TOKEN_JWT_SECRET_KEY=ilovekiyarawithkiabdy

# Infrastructure
REDIS_URL=redis://localhost:6379
# 29092, not 9092 — the broker advertises itself as `kafka:9092` on the internal
# listener, which the host cannot resolve. 29092 is the PLAINTEXT_HOST listener.
KAFKA_BROKERS=localhost:29092

SNAPSHOT_PATH=engine-state.json
WEB_URL=http://localhost:5173

# apps/web reads these through import.meta.env, not @repo/env-config.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

