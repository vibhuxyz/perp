# Copy to .env at the repo root. Required variables throw at boot if unset.

# Matches the credentials in docker-compose.dev.yml.
DATABASE_URL=postgres://perp:password@localhost:5432/perp_db
JWT_SECRET=change-me

PORT=6000
WS_PORT=7000

REDIS_URL=redis://localhost:6379
# 29092, not 9092 — the broker advertises itself as `kafka:9092` on the internal
# listener, which the host cannot resolve. 29092 is the PLAINTEXT_HOST listener.
KAFKA_BROKERS=localhost:29092

SNAPSHOT_PATH=engine-state.json
WEB_URL=http://localhost:5173

# apps/web reads these through import.meta.env, not @repo/env-config.
VITE_API_URL=http://localhost:6000
VITE_WS_URL=ws://localhost:7000
