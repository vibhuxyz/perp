# ==========================================
# PERP EXCHANGE - PRODUCTION TEMPLATE
# (Place actual values in GitHub Secrets or on the EC2 host)
# ==========================================

NODE_ENV=production
DOCKERHUB_USERNAME=your_dockerhub_username
IMAGE_TAG=latest

# Database: Managed PostgreSQL (Neon / Supabase / Timescale)
DATABASE_URL=postgresql://user:password@host:5432/perp_db?sslmode=require

# Redis: Managed Redis (Upstash / Redis Cloud with TLS)
REDIS_URL=rediss://default:password@host:6379

# Shared Kafka Container
KAFKA_BROKERS=shared-kafka:9092

# ==========================================
# PORTS
# ==========================================

API_GATEWAY_PORT=8080
PORT=3000
WS_PORT=7070

# ==========================================
# GATEWAY ROUTING
# ==========================================

AUTH_SERVICE_URL=http://perp-server:3000
ORDER_SERVICE_URL=http://perp-server:3000
MARKET_SERVICE_URL=http://perp-server:3000
WALLET_SERVICE_URL=http://perp-server:3000
WS_SERVICE_URL=ws://perp-ws:7070

# ==========================================
# JWT SECRETS (32+ chars)
# ==========================================

JWT_SECRET="replace-with-secure-32-char-random-secret"
ACCESS_TOKEN_JWT_SECRET_KEY="replace-with-secure-32-char-random-secret"
REFRESH_TOKEN_JWT_SECRET_KEY="replace-with-secure-32-char-random-secret"

# ==========================================
# CORS
# ==========================================

CORS_ORIGINS=http://perp-prod.s3-website.ap-south-1.amazonaws.com,http://localhost:5173
WEB_URL=http://perp-prod.s3-website.ap-south-1.amazonaws.com

# ==========================================
# ENGINE PERSISTENCE
# ==========================================

WAL_PATH=/data/engine.wal
SNAPSHOT_PATH=/data/engine-state.json

# ==========================================
# AMAZON S3 - UNIFIED BUCKET (WEB + BACKUPS)
# Bucket: perp-prod
# Folders:
#   - perp-prod/web/     (Frontend build)
#   - perp-prod/backups/ (Engine snapshots)
# ==========================================

S3_BUCKET_NAME=perp-prod
S3_BACKUP_BUCKET=perp-prod
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
