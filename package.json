{
  "name": "perp-v2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean:ports": "kill -9 $(lsof -ti :5173,6000,7070,8080) 2>/dev/null || true",
    "lint": "turbo run lint",
    "test": "bun apps/engine/tests/test.engine.ts",
    "test:all": "for f in apps/engine/tests/test.*.ts; do echo \"=== $f ===\"; bun \"$f\" || exit 1; done",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "cd packages/db && bunx prisma generate",
    "db:migrate": "bun run db:guard && cd packages/db && dotenv -e ../../.env -- bunx prisma migrate dev ",
    "db:seed": "cd packages/db-mongo && bun run db:seed"
  },
  "devDependencies": {
    "@repo/shared": "workspace:*",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3"
  }
}
